# Development defaults only. Production validation rejects these values.
POSTGRES_PASSWORD=visibility
APP_DB_PASSWORD=visibility-app-local
WORKER_DB_PASSWORD=visibility-worker-local
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
BIND_ADDRESS=127.0.0.1
APP_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=visibility_session
SESSION_SAME_SITE=lax
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_RETENTION_SECONDS=604800
SESSION_CLEANUP_BATCH_SIZE=500
MOCK_AUTH_ENABLED=true
SECURE_COOKIES=false
EXPOSE_API_DOCS=true
METRICS_ENABLED=true
# Production metrics require a separate 32+ character bearer token when enabled.
METRICS_BEARER_TOKEN=
# Production OIDC configuration. Pre-provision users in the users table.
OIDC_SERVER_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_AUTO_LINK_VERIFIED_EMAIL=false
OIDC_SCOPES=openid profile email
AUDIT_STEP_DELAY_SECONDS=0.35
AUDIT_RATE_LIMIT=3
AUDIT_RATE_WINDOW_SECONDS=60
AUDIT_MAX_ATTEMPTS=3
AUDIT_LEASE_SECONDS=30
AUDIT_RETRY_DELAY_SECONDS=1
AUDIT_RETRY_MAX_DELAY_SECONDS=60
AUDIT_RETRY_JITTER_RATIO=0.2
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_MAX_BACKOFF_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEALTH_TIMEOUT_SECONDS=30
CURSOR_PAGE_SIZE=20
CURSOR_MAX_PAGE_SIZE=100
AUDIT_EVIDENCE_PAGE_SIZE=20
AUDIT_EVIDENCE_MAX_PAGE_SIZE=100
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
OTEL_SERVICE_NAME=visibility-audit
# Full OTLP/HTTP traces URL, for example http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
